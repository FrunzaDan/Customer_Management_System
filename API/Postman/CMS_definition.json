{
  "openapi": "3.0.1",
  "info": {
    "title": "CustomerManagementSystem.WebAPI",
    "version": "1.0"
  },
  "paths": {
    "/api/Authentication/access-token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/MerchantCredentials"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MerchantCredentials"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MerchantCredentials"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MerchantCredentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Authentication/verify-token": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "parameters": [
          {
            "name": "accessToken",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectResponseModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectResponseModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectResponseModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/Customer/register": {
      "post": {
        "tags": [
          "Customer"
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerModel"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Customer/get": {
      "get": {
        "tags": [
          "Customer"
        ],
        "parameters": [
          {
            "name": "searchVariable",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Customer/all": {
      "get": {
        "tags": [
          "Customer"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Customer/edit": {
      "patch": {
        "tags": [
          "Customer"
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerModel"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Customer/deactivate": {
      "patch": {
        "tags": [
          "Customer"
        ],
        "parameters": [
          {
            "name": "customerGuid",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Customer/delete": {
      "delete": {
        "tags": [
          "Customer"
        ],
        "parameters": [
          {
            "name": "customerGuid",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressModel": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "nullable": true
          },
          "county": {
            "type": "string",
            "nullable": true
          },
          "town": {
            "type": "string",
            "nullable": true
          },
          "zip": {
            "type": "string",
            "nullable": true
          },
          "street": {
            "type": "string",
            "nullable": true
          },
          "number": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CustomerModel": {
        "type": "object",
        "properties": {
          "guid": {
            "type": "string",
            "nullable": true
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "msisdn": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "customerStatus": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "creationDate": {
            "type": "string",
            "nullable": true
          },
          "interactionDate": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "birthdate": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "$ref": "#/components/schemas/AddressModel"
          }
        },
        "additionalProperties": false
      },
      "MerchantCredentials": {
        "required": [
          "merchantId",
          "merchantPassword"
        ],
        "type": "object",
        "properties": {
          "merchantId": {
            "minLength": 1,
            "type": "string"
          },
          "merchantPassword": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ObjectResponseModel": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "responseMessage": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Put **_ONLY_** your JWT Bearer token on textbox below!",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ]
}